# Email delivery for the "Programează o discuție" form (src/app/actions/lead.ts).
# Copy this file to .env.local (never committed) and fill in your mailbox's SMTP details.
# Without them, requests are only printed in the dev server log, and in production
# the form shows an error with the email address and phone number instead.

SMTP_HOST=
# 465 = SSL/TLS (default), 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: sender address (defaults to SMTP_USER) and where requests go.
SMTP_FROM=
CONTACT_TO=cxc@dive-software.ro
